		"panels": [
			{
				"id": "main",
				"title": "billion-context",
				"entry": "app.html",
				"icon": "activity",
				"presentation": "popover"
			}
		],
		"commands": [{ "id": "open", "title": "billion-context", "panelId": "main" }]
	}
}
