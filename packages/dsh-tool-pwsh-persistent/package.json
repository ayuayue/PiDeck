{
  "name": "dsh-tool-pwsh-persistent",
  "version": "0.1.2",
  "description": "DSH persistent PowerShell tool: reuse one owner-scoped pwsh session via node-pty (Windows-first, no ctx.terminals).",
  "type": "module",
  "license": "MIT",
  "author": "PiDeck contributors",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "powershell",
    "pwsh",
    "persistent-shell"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "node-pty": "^1.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-pwsh-local": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-pwsh-local": { "optional": true },
    "@deepseek-ai/dsh-timeout": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
